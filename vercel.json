{
  "cleanUrls": true,
  "rewrites": [{ "source": "/:slug", "destination": "/index.html" }],
  "headers": [
    { "source": "/og.jpg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
